# ===== 用户数据 / 登录凭证 (绝不提交) =====
desktop/data.db*
desktop/_tb_login_profile/
desktop/smoke-tmp/
desktop/test-tmp*/
desktop/rules-tmp/
desktop/shell-tmp/

# ===== 构建产物 =====
# 约定: 所有构建产物与探针临时件都集中在 desktop/build/ 下(dist/pybuild/spec/logs/probe),
# 用 desktop/清理构建.bat 一键删干净。下面的 desktop/dist/ 等是旧布局, 保留兼容。
desktop/build/
desktop/dist/
releases/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/capture/

# ===== 本机环境 / 私有内容 (不发布) =====
android-sdk/
.zcode/
_local/
.workbuddy/
.workbuddy-ai/

# ===== 构建工具/依赖 (本机留存, 不入库) =====
desktop/installer/redist/
desktop/installer/tools/
desktop/installer/*.zip

# ===== 临时探针 / 验证产物 (目录) =====
desktop/_tmp*/
desktop/_verify*/
desktop/_chk_pid*/
desktop/_acnet*/
desktop/_bq_probe_profile/
desktop/_bq_fixture/
desktop/_exe_tmp/
desktop/_ghost/
desktop/_sr_compare/
desktop/_x29/
desktop/_a4k/
desktop/_ref_bili/
desktop/_framegen_shelf/
desktop/_ext_variants/
desktop/backups/

# 验证报告目录: 只保留 REPORT_*.md, 其余(截图/日志)不入库
desktop/_vis/*
!desktop/_vis/REPORT_*.md

# ===== 散落的探针产物 / 脚本 (desktop 根下, 名字以 _ 开头) =====
desktop/_*
!desktop/_vis/
desktop/_vis/*
!desktop/_vis/REPORT_*.md
desktop/r2.txt
desktop/r3.txt
desktop/s2.txt
desktop/s3.txt
desktop/rules_out.txt
desktop/smoke_out.txt
desktop/build_log_*.txt
desktop/'

# ===== 常见垃圾 =====
__pycache__/
*.py[cod]
*.log
nul
.idea/
*.iml
.DS_Store
Thumbs.db

# 运行时诊断产物
desktop/tb_debug.jsonl

# PyInstaller 生成的 spec(每次构建自动生成)
desktop/*.spec

# 清理清单等一次性产物
_cleanup_manifest_*.txt

# ===== 快速文本分析(v0.3.1.43dsk) =====
# 训练管线入库(可复现), 语料/权重/工具链这些大件不入库 —— 权重另有 desktop/model/ 那份
!desktop/_vis/fasttext_demo/
!desktop/_vis/fasttext_demo/*.py
desktop/_vis/fasttext_demo/_*
desktop/_vis/fasttext_demo/*.bin
desktop/_vis/fasttext_demo/*.txt
desktop/_vis/fasttext_demo/*.json

# 本版新增的测试 / 验收脚本入库(可重跑的回归资产);
# 历史探针仍按上面的 desktop/_* 规则忽略, 不追加入库
!desktop/_test_ft.py
!desktop/_ft_ui_test.js
!desktop/_test_tabstrip_drag_gui.py
!desktop/_verify_exe.py
!desktop/_test_am_retry.py
!desktop/_bench_gear.py
!desktop/_bench_q.py
# v0.3.1.46dsk: 弹幕侧 fastText 门控的**行为级**回归(node 沙盒 + 真实 seg.so 字节流)。
# 静态断言抓不住这次这个 bug —— 出错的是一行完全合法的赋值, 只有真跑钩子看它发没发
# 请求才能守住。node 是打包链之外的工具, 所以不塞进 test_shell.py, 单独可重跑。
!desktop/_test_dm_ft_gate.js
# v0.3.1.46dsk: 打包产物三层验收(归档内容 → 跑沙盒 → 隔离库起 exe)。
# 版本无关(从 exe 文件名反推), 每版都能跑; 里面"打包内 userscript 与源码字节一致"
# 这条对**任何**改过 extensions/ 的版本都成立, 是通用回归。
!desktop/_verify_dmft_gate.py

# v0.4.1dsk: 自动更新的回归资产(后端 78 项 + 前端 20 项)与打包反解校验。
!desktop/_test_update_v041.py
!desktop/_test_update_ui_v041.js
!desktop/_verify_exe_v041.py

